# The embed preview borrows @discord-message-components/react, which peer-depends on React 17.
# It renders on this tree's React 19 - the prerendered build is the proof - so the peer range is
# answered here instead of being argued with in every install: without this line `npm ci` stops
# with ERESOLVE before it reads a word of the lockfile.
legacy-peer-deps=true
