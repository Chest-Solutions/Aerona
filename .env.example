# Aerona configuration — the values below are what `main.py` reads on a first boot.
#
# You do not have to copy this by hand: `python3 main.py` with no `.env` present writes one
# from this file (mode 0600, with a generated AERONA_MASTER_KEY) and tells you that the
# token is the remaining blank. On a game panel, set the variables in the panel instead —
# the environment always beats `.env`.
#
# This file is generated in spirit from `aerona_core::config::DOTENV_TEMPLATE`
# (crates/aerona-core/src/config.rs); a unit test compares the keys and defaults of
# both, so the documentation cannot drift away from what the program actually reads.
# Only AERONA_* and SIGHTENGINE_TOKEN are read; unknown keys are ignored on purpose,
# so a leftover from an older version never breaks a start.
#
# Everything below is the template. Values here are placeholders or defaults.

# Aerona — required
AERONA_TOKEN=put-your-discord-bot-token-here
AERONA_PORT=8080

# Set to "off" to run the dashboard with no Discord worker (the token then becomes
# optional, and a persistent pepper is written to data/install.key on first boot).
# Anything else, including a blank value, means "connect to Discord".
AERONA_BOT=

# AI text moderation (sightengine.com). Format: user:secret
# Get both from https://dashboard.sightengine.com/account
SIGHTENGINE_TOKEN=

# Aerona — optional
# The exact origin your browser types, port included, no trailing slash —
# http://node:25154 is a valid value, http://node:25154/ is not. Left empty, the API
# accepts the host you actually reach it on (an IP with a port, `localhost`, a
# `*.localhost` name), which is what a game panel or a tunnel wants. A named install
# must set it: a name nobody configured is refused for browser writes (that is the DNS
# rebinding guard, not a bug) and Discord sign-in stays off, because there is no safe
# redirect target to build from an unverified `Host`. Plain http works and is what a
# panel gives you; `https://` is what earns the session cookie a `Secure` flag.
# `AERONA_SITE_ORIGIN` is the same idea at build time: it is what gets baked into the
# canonical URLs, the sitemap and `og:url`, and `main.py` never reads it.
AERONA_BASE_URL=
# Discord's OAuth callback, verbatim, for when the portal entry is not exactly the origin
# above + /auth/callback. Discord compares character for character: a
# trailing slash, http vs https, localhost vs the IP you dial, or a changed port all
# produce "Invalid OAuth2 redirect_uri" on Discord's page. Set it here and both halves of
# the flow use it; `python3 main.py check` prints the value in use and what to paste.
AERONA_OAUTH_REDIRECT_URI=
AERONA_DISCORD_CLIENT_ID=
AERONA_DISCORD_CLIENT_SECRET=
# Pepper for session/API-key MACs. If unset, one is generated at first boot and
# stored in data/aerona.db — set it explicitly if you replicate the DB.
AERONA_MASTER_KEY=
AERONA_DB=data/aerona.db
AERONA_DATA_DIR=data
# Where the built dashboard is served from (relative to this directory).
AERONA_STATIC_DIR=dashboard/dist
AERONA_SESSION_HOURS=12
AERONA_RATE_RPS=20
AERONA_RATE_BURST=60
AERONA_LOG_LEVEL=info
# Opt in to the privileged Message Content intent (needed for prefix commands).
AERONA_CONTENT_INTENT=false
# Extra origins allowed to call the API with credentials. Empty = same-origin only.
AERONA_CORS_ORIGINS=
# Set to true ONLY when a reverse proxy you control terminates TLS in front of
# Aerona. It makes X-Forwarded-For authoritative for rate limiting and audit;
# without it a client cannot spoof its address into a different rate-limit bucket.
AERONA_TRUSTED_PROXY=false
# Outbound request timeouts for the Discord login flow, in seconds.
AERONA_HTTP_TIMEOUT_SECS=10
AERONA_HTTP_CONNECT_TIMEOUT_SECS=5
# Days of audit/events/stats kept before the hourly retention pass deletes them.
AERONA_RETENTION_DAYS=90
